{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reposit Customer API - OpenAPI 3.0",
    "version": "2023.5.1"
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login route",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.repositpower.com/v2/auth/login/",
            "headers": [
              {
                "name": "Reposit-Auth",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Log into your account and receive an authentication token"
        },
        {
          "info": {
            "name": "Auth token refresh route",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.repositpower.com/v2/auth/refresh/",
            "headers": [
              {
                "name": "Reposit-Auth",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Post your refresh token to this route when using API auth in order to get a new token"
        },
        {
          "info": {
            "name": "This endpoint returns all userkeys/battery system identifiers for the current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.repositpower.com/v2/userkeys/",
            "headers": [
              {
                "name": "Reposit-Auth",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint returns all userkeys/battery system identifiers for the current user"
        }
      ]
    },
